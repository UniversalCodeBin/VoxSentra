# VoxSentra configuration
APP_NAME=Voice Integrity API
ENVIRONMENT=development

# SECURITY: JWT signing secret — must be long random string, never committed to git.
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate limits (per minute/hour as shown)
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REFRESH=20/minute
RATE_LIMIT_PASSWORD_RESET=3/hour
RATE_LIMIT_EMAIL_VERIFICATION=5/hour
RATE_LIMIT_ANALYZE=30/minute
RATE_LIMIT_CHUNK=120/minute

# Email service (development: logs to console; production: configure SMTP/API)
EMAIL_PROVIDER=development
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Database
DATABASE_URL=sqlite:///./voice_integrity.db
DB_HOST_RESTRICTION=True -> bind to 127.0.0.1 / private interface; firewall 5432/3306 from public
BOT_PROTECTION=basic  # WAF/CDN recommended; this is baseline UA-filter only
